#include <iostream>
#include <vector>
#include <string>
#include <iomanip>
#include <algorithm>

using namespace std;

// ================= PRODUCT =================

struct Product {
    int id;
    string name;
    string category;
    double oldPrice;
    double price;
    int rating;
};

// ================= CART ITEM =================

struct CartItem {
    Product product;
    int quantity;
};

// ================= GLOBAL DATA =================

vector<Product> products = {
    {1, "Smart Watch", "Smart Wear", 4999, 2999, 5},
    {2, "Wireless Headphones", "Audio", 3499, 1999, 5},
    {3, "Gaming Keyboard", "Accessories", 2499, 1499, 4},
    {4, "Wireless Mouse", "Accessories", 1199, 799, 5},
    {5, "Smartphone", "Mobiles", 24999, 19999, 4},
    {6, "Laptop", "Laptops", 69999, 54999, 5},
    {7, "Gaming Controller", "Gaming", 3999, 2499, 4},
    {8, "Smart Band", "Smart Wear", 2999, 1799, 4}
};

vector<CartItem> cart;
vector<int> wishlist;


// ================= DISPLAY PRODUCTS =================

void displayProduct(Product p) {

    cout << "\n----------------------------------------\n";
    cout << "Product ID   : " << p.id << endl;
    cout << "Product Name : " << p.name << endl;
    cout << "Category     : " << p.category << endl;

    cout << "Old Price    : Rs." << fixed
         << setprecision(2) << p.oldPrice << endl;

    cout << "Price        : Rs." << p.price << endl;

    double discount =
        ((p.oldPrice - p.price) / p.oldPrice) * 100;

    cout << "Discount     : "
         << fixed << setprecision(0)
         << discount << "%" << endl;

    cout << "Rating       : ";

    for (int i = 0; i < p.rating; i++)
        cout << "*";

    cout << endl;

    cout << "----------------------------------------\n";
}


// ================= DISPLAY ALL PRODUCTS =================

void displayProducts() {

    cout << "\n========================================\n";
    cout << "        MATHAN MART - PRODUCTS\n";
    cout << "========================================\n";

    for (auto p : products) {
        displayProduct(p);
    }
}


// ================= SEARCH PRODUCTS =================

void searchProducts() {

    string search;

    cout << "\nEnter product name to search: ";
    cin.ignore();
    getline(cin, search);

    transform(search.begin(), search.end(),
              search.begin(), ::tolower);

    bool found = false;

    for (auto p : products) {

        string name = p.name;

        transform(name.begin(), name.end(),
                  name.begin(), ::tolower);

        if (name.find(search) != string::npos) {
            displayProduct(p);
            found = true;
        }
    }

    if (!found) {
        cout << "\nProduct not found!\n";
    }
}


// ================= CATEGORY =================

void displayCategories() {

    cout << "\n========================================\n";
    cout << "             CATEGORIES\n";
    cout << "========================================\n";

    cout << "1. Mobiles\n";
    cout << "2. Laptops\n";
    cout << "3. Audio\n";
    cout << "4. Accessories\n";
    cout << "5. Smart Wear\n";
    cout << "6. Gaming\n";
}


// ================= PRODUCTS BY CATEGORY =================

void categoryProducts() {

    displayCategories();

    int choice;

    cout << "\nEnter category number: ";
    cin >> choice;

    string category;

    switch (choice) {

        case 1:
            category = "Mobiles";
            break;

        case 2:
            category = "Laptops";
            break;

        case 3:
            category = "Audio";
            break;

        case 4:
            category = "Accessories";
            break;

        case 5:
            category = "Smart Wear";
            break;

        case 6:
            category = "Gaming";
            break;

        default:
            cout << "\nInvalid category!\n";
            return;
    }

    cout << "\nProducts in " << category << ":\n";

    bool found = false;

    for (auto p : products) {

        if (p.category == category) {
            displayProduct(p);
            found = true;
        }
    }

    if (!found)
        cout << "No products available.\n";
}


// ================= ADD TO CART =================

void addToCart() {

    int id;

    cout << "\nEnter Product ID to add to cart: ";
    cin >> id;

    for (auto p : products) {

        if (p.id == id) {

            int quantity;

            cout << "Enter quantity: ";
            cin >> quantity;

            if (quantity <= 0) {
                cout << "Invalid quantity!\n";
                return;
            }

            bool exists = false;

            for (auto &item : cart) {

                if (item.product.id == id) {

                    item.quantity += quantity;
                    exists = true;

                    cout << "\nProduct quantity updated!\n";
                    return;
                }
            }

            if (!exists) {

                cart.push_back({p, quantity});

                cout << "\n"
                     << p.name
                     << " added to your cart!\n";
            }

            return;
        }
    }

    cout << "\nProduct not found!\n";
}


// ================= SHOW CART =================

void showCart() {

    if (cart.empty()) {

        cout << "\nYour cart is empty.\n";
        return;
    }

    cout << "\n========================================\n";
    cout << "             YOUR CART\n";
    cout << "========================================\n";

    double total = 0;

    for (auto item : cart) {

        double itemTotal =
            item.product.price * item.quantity;

        cout << "\nProduct  : "
             << item.product.name << endl;

        cout << "Price    : Rs."
             << item.product.price << endl;

        cout << "Quantity : "
             << item.quantity << endl;

        cout << "Subtotal : Rs."
             << itemTotal << endl;

        total += itemTotal;
    }

    cout << "\n----------------------------------------\n";

    cout << "TOTAL : Rs."
         << fixed << setprecision(2)
         << total << endl;

    cout << "----------------------------------------\n";
}


// ================= REMOVE FROM CART =================

void removeFromCart() {

    if (cart.empty()) {

        cout << "\nCart is empty.\n";
        return;
    }

    int id;

    cout << "\nEnter Product ID to remove: ";
    cin >> id;

    for (auto it = cart.begin();
         it != cart.end();
         ++it) {

        if (it->product.id == id) {

            cout << "\n"
                 << it->product.name
                 << " removed from cart.\n";

            cart.erase(it);

            return;
        }
    }

    cout << "\nProduct not found in cart.\n";
}


// ================= CLEAR CART =================

void clearCart() {

    if (cart.empty()) {

        cout << "\nCart is already empty.\n";
        return;
    }

    cart.clear();

    cout << "\nCart cleared successfully!\n";
}


// ================= WISHLIST =================

void addWishlist() {

    int id;

    cout << "\nEnter Product ID for wishlist: ";
    cin >> id;

    for (auto p : products) {

        if (p.id == id) {

            if (find(wishlist.begin(),
                     wishlist.end(),
                     id) != wishlist.end()) {

                cout << "\nAlready in wishlist!\n";
                return;
            }

            wishlist.push_back(id);

            cout << "\n"
                 << p.name
                 << " added to wishlist!\n";

            return;
        }
    }

    cout << "\nProduct not found!\n";
}


// ================= SHOW WISHLIST =================

void showWishlist() {

    if (wishlist.empty()) {

        cout << "\nWishlist is empty.\n";
        return;
    }

    cout << "\n========================================\n";
    cout << "             WISHLIST\n";
    cout << "========================================\n";

    for (int id : wishlist) {

        for (auto p : products) {

            if (p.id == id) {

                cout << "\n";
                displayProduct(p);
            }
        }
    }
}


// ================= DEALS =================

void showDeals() {

    cout << "\n========================================\n";
    cout << "          🔥 MEGA FLASH SALE\n";
    cout << "========================================\n";

    cout << "\nUp to 50% OFF on selected products!\n";

    for (auto p : products) {

        double discount =
            ((p.oldPrice - p.price)
            / p.oldPrice) * 100;

        if (discount >= 40) {
            displayProduct(p);
        }
    }
}


// ================= CHECKOUT =================

void checkout() {

    if (cart.empty()) {

        cout << "\nYour cart is empty!\n";
        return;
    }

    double total = 0;

    for (auto item : cart) {

        total +=
            item.product.price *
            item.quantity;
    }

    cout << "\n========================================\n";
    cout << "              CHECKOUT\n";
    cout << "========================================\n";

    cout << "Total Amount : Rs."
         << fixed << setprecision(2)
         << total << endl;

    cout << "\nPayment Methods\n";
    cout << "1. UPI\n";
    cout << "2. Debit/Credit Card\n";
    cout << "3. Cash on Delivery\n";

    int payment;

    cout << "\nChoose payment method: ";
    cin >> payment;

    if (payment < 1 || payment > 3) {

        cout << "\nInvalid payment method!\n";
        return;
    }

    cout << "\nOrder placed successfully! 🎉\n";
    cout << "Thank you for shopping with Mathan Mart!\n";

    cart.clear();
}


