void mainMenu() {

    int choice;

    do {

        cout << "\n\n";
        cout << "========================================\n";
        cout << "          🛒 MATHAN MART 🛒\n";
        cout << "       Shop Smart. Live Better.\n";
        cout << "========================================\n";

        cout << "\n1. View Products";
        cout << "\n2. Search Products";
        cout << "\n3. Shop by Category";
        cout << "\n4. 🔥 View Deals";
        cout << "\n5. Add Product to Cart";
        cout << "\n6. View Cart";
        cout << "\n7. Remove Product from Cart";
        cout << "\n8. Clear Cart";
        cout << "\n9. Add to Wishlist";
        cout << "\n10. View Wishlist";
        cout << "\n11. Checkout";
        cout << "\n12. Exit";

        cout << "\n\nEnter your choice: ";
        cin >> choice;

        switch (choice) {

            case 1:
                displayProducts();
                break;

            case 2:
                searchProducts();
                break;

            case 3:
                categoryProducts();
                break;

            case 4:
                showDeals();
                break;

            case 5:
                addToCart();
                break;

            case 6:
                showCart();
                break;

            case 7:
                removeFromCart();
                break;

            case 8:
                clearCart();
                break;

            case 9:
                addWishlist();
                break;

            case 10:
                showWishlist();
                break;

            case 11:
                checkout();
                break;

            case 12:
                cout << "\nThank you for visiting Mathan Mart! 🛒\n";
                break;

            default:
                cout << "\nInvalid choice! Please try again.\n";
        }

    } while (choice != 12);
}


